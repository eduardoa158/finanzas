{
  // Configuración de Cloudflare Workers (assets estáticos) para la SPA.
  // Sirve la carpeta ./dist y, para CUALQUIER ruta que no sea un archivo,
  // devuelve index.html (modo Single Page Application). Esto reemplaza al
  // archivo _redirects de Pages, que Workers no admite.
  "name": "finanzas1",
  "compatibility_date": "2025-11-01",
  // Compila la app (genera ./dist) antes de desplegar. Así funciona aunque
  // el panel de Cloudflare no tenga configurado el "Build command".
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
